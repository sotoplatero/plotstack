{
  "name": "plotstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first newsletter analytics dashboard for Chrome.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/validate-extension.mjs && node scripts/package-extension.mjs",
    "screenshot": "node scripts/store-screenshot.mjs",
    "preview": "node scripts/preview-dashboard.mjs"
  }
}
