{
  "manifest_version": 3,
  "name": "PlotStack — Newsletter Analytics",
  "short_name": "PlotStack",
  "version": "1.0.0",
  "description": "Tus métricas de newsletter, ordenadas en un solo dashboard local.",
  "homepage_url": "https://github.com/sotoplatero/plotstack",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "tabs", "cookies", "downloads", "clipboardWrite"],
  "host_permissions": ["https://substack.com/*", "https://*.substack.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir PlotStack",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
